<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="내 약"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_total_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="총 0개 등록됨"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btn_add_medicine"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="+ 약 추가"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:background="@drawable/bg_button_primary"
                    android:paddingHorizontal="20dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <!-- OCR Button -->
            <Button
                android:id="@+id/btn_ocr"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="📷  처방전 촬영"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_button_primary"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

            <!-- 상호작용 검사 Button -->
            <Button
                android:id="@+id/btn_check_interaction"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="⚠  함께 먹어도 되나요? (상호작용 검사)"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <!-- 알림 시간 설정 링크 -->
            <TextView
                android:id="@+id/btn_slot_times"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="⏰ 복용 알림 시간 설정"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:padding="6dp" />

            <!-- Morning Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌅"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아침"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tv_morning_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0개)"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_morning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_empty_morning"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/transparent"
                android:visibility="visible">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="등록된 약이 없어요"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_empty_state" />
            </androidx.cardview.widget.CardView>

            <!-- Lunch Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="점심"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tv_lunch_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0개)"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_lunch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_empty_lunch"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/transparent"
                android:visibility="visible">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="등록된 약이 없어요"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_empty_state" />
            </androidx.cardview.widget.CardView>

            <!-- Evening Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌙"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="저녁"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tv_evening_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0개)"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_evening"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_empty_evening"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/transparent"
                android:visibility="visible">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="등록된 약이 없어요"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_empty_state" />
            </androidx.cardview.widget.CardView>

            <!-- Bedtime Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌛"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="취침 전"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tv_bedtime_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0개)"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_bedtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_empty_bedtime"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/transparent"
                android:visibility="visible">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="등록된 약이 없어요"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:background="@drawable/bg_empty_state" />
            </androidx.cardview.widget.CardView>

            <View android:layout_width="match_parent" android:layout_height="100dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
